---
/**
 * Formulir autentikasi orang tua (VRD 3.1–3.2 bagian klien).
 *
 * Dipakai dua halaman: /login (mode "login") dan /daftar (mode "register").
 * Kirim JSON ke endpoint auth yang sudah ada; tanpa JavaScript, browser
 * melakukan POST form-urlencoded biasa ke endpoint yang sama sehingga kata
 * sandi tetap di body (bukan di URL) dan server menjawab 400 dengan aman.
 */
interface Props {
  mode: "login" | "register";
}

const { mode } = Astro.props;
const isRegister = mode === "register";
const endpoint = isRegister ? "/api/auth/register" : "/api/auth/login";
const title = isRegister ? "Buat akun orang tua" : "Masuk ke akun orang tua";
const intro = isRegister
  ? "Satu akun untuk mendampingi belajar anak."
  : "Masuk untuk membuka area orang tua.";
const submitLabel = isRegister ? "Buat akun" : "Masuk";
const altHref = isRegister ? "/login" : "/daftar";
const altText = isRegister ? "Sudah punya akun? Masuk" : "Belum punya akun? Daftar";
---

<section class="auth">
  <div class="card">
    <h1>{title}</h1>
    <p class="intro">{intro}</p>

    <form data-auth data-endpoint={endpoint} method="post" action={endpoint}>
      {
        isRegister && (
          <div class="field">
            <label for="displayName">Nama panggilan</label>
            <input
              id="displayName"
              name="displayName"
              type="text"
              required
              maxlength="80"
              autocomplete="nickname"
              placeholder="Mis. Bunda"
            />
          </div>
        )
      }

      <div class="field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          inputmode="email"
          placeholder="nama@contoh.com"
        />
      </div>

      <div class="field">
        <label for="password">Kata sandi</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          maxlength="200"
          autocomplete={isRegister ? "new-password" : "current-password"}
        />
        {
          isRegister && (
            <p class="hint">Minimal 8 karakter.</p>
          )
        }
      </div>

      <p class="status" id="auth-status" role="status" aria-live="polite"></p>

      <button class="btn-primary" type="submit">{submitLabel}</button>
    </form>

    <p class="alt">
      <a href={altHref}>{altText}</a>
    </p>
    <p class="alt">
      <a href="/">Kembali ke beranda</a>
    </p>
  </div>
</section>

<script>
  // Kirim JSON ke endpoint auth; status sibuk/galat ditampilkan sebagai teks
  // (status tidak disampaikan lewat warna saja).
  const form = document.querySelector<HTMLFormElement>("form[data-auth]");
  const status = document.getElementById("auth-status");
  const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  function setStatus(message: string, tone: "busy" | "ok" | "error") {
    if (!status) return;
    status.textContent = message;
    status.dataset.tone = tone;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submit || submit.disabled) return;

    const endpoint = form.dataset.endpoint ?? "";
    const payload = Object.fromEntries(new FormData(form).entries());

    submit.disabled = true;
    const idleLabel = submit.textContent;
    submit.textContent = "Memproses…";
    setStatus("", "busy");

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
        credentials: "same-origin",
      });
      const data: unknown = await res.json().catch(() => null);
      const ok =
        res.ok &&
        typeof data === "object" &&
        data !== null &&
        (data as { ok?: unknown }).ok === true;

      if (ok) {
        setStatus("Berhasil. Membuka area orang tua…", "ok");
        window.location.assign("/parent");
        return;
      }

      const message =
        typeof data === "object" && data !== null &&
        typeof (data as { message?: unknown }).message === "string"
          ? (data as { message: string }).message
          : "Coba lagi sebentar lagi.";
      setStatus(message, "error");
    } catch {
      setStatus("Jaringan bermasalah. Periksa koneksi lalu coba lagi.", "error");
    } finally {
      submit.disabled = false;
      if (idleLabel !== null) submit.textContent = idleLabel;
    }
  });
</script>

<style>
  .auth {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-6) 0;
  }

  .card {
    width: min(100%, 420px);
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--sp-6);
  }

  h1 {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-2);
  }

  .intro {
    color: var(--c-muted-ink);
    margin-bottom: var(--sp-5);
  }

  .field {
    margin-bottom: var(--sp-4);
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }

  input {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--c-ink);
    background: var(--c-ivory);
    border: var(--border-subtle);
    border-radius: var(--r-control);
  }

  input::placeholder {
    color: var(--c-muted-ink);
  }

  .hint {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
  }

  /* Ruang status selalu dipesan agar layout tidak melompat saat pesan muncul. */
  .status {
    min-height: 1.5em;
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-ink);
  }

  /* Ikuti komponen `error-note`/`badge-success` DESIGN.md: permukaan bertint
     + teks gelap (kontras ≥4.5:1) — bukan teks merah/hijau di atas putih. */
  .status[data-tone="error"] {
    background: var(--c-soft-peach);
    color: var(--c-ink);
    border-radius: var(--r-control);
    padding: var(--sp-2) var(--sp-3);
    font-weight: 600;
  }

  .status[data-tone="ok"] {
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    border-radius: var(--r-control);
    padding: var(--sp-2) var(--sp-3);
    font-weight: 600;
  }

  .status[data-tone="busy"] {
    color: var(--c-muted-ink);
  }

  .btn-primary {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--r-card);
    background: var(--c-deep-green);
    color: var(--c-warm-white);
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--dur-tap) var(--ease-out);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .alt {
    margin: var(--sp-4) 0 0;
    text-align: center;
    font-size: var(--fs-sm);
  }

  .alt + .alt {
    margin-top: var(--sp-2);
  }
</style>
