---
/**
 * Kartu profil anak untuk area orang tua (VRD 4.8, 4.11).
 * Menampilkan ringkasan profil + aksi edit/arsip dengan gerbang orang tua.
 */
interface Props {
  child: {
    childId: string;
    nickname: string;
    age: number;
    avatarKey: string | null;
    language: string;
    learningGoals: string[];
    archivedAt: Date | null;
    createdAt: Date;
  };
  isActive: boolean;
  onSelect: string; // URL untuk memilih anak ini (child switcher)
  onEdit: string;   // URL untuk edit
  onArchive: string; // URL untuk arsip (DELETE)
}

const { child, isActive, onSelect, onEdit, onArchive } = Astro.props;

const avatarSVGs: Record<string, string> = {
  star: `<svg viewBox="0 0 24 24" fill="none" stroke="#174A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`,
  moon: `<svg viewBox="0 0 24 24" fill="none" stroke="#174A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`,
  book: `<svg viewBox="0 0 24 24" fill="none" stroke="#174A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`,
  lantern: `<svg viewBox="0 0 24 24" fill="none" stroke="#174A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 16v6M4 22h16M6 8h12M6 14h12"></path></svg>`,
};

const avatar = child.avatarKey && avatarSVGs[child.avatarKey] ? avatarSVGs[child.avatarKey] : avatarSVGs.star;
const ageLabel = `Usia ${child.age} tahun`;
const goalsPreview = child.learningGoals.length > 0
  ? child.learningGoals.slice(0, 2).join(", ") + (child.learningGoals.length > 2 ? " …" : "")
  : "Belum ada tujuan";

---

<article class={`profile-card ${isActive ? "active" : ""} ${child.archivedAt ? "archived" : ""}`} data-child-id={child.childId}>
  <div class="card-header">
    <div class="avatar-wrap" aria-hidden="true">
      {avatar}
    </div>
    <div class="info">
      <h2>{child.nickname}</h2>
      <p class="meta">{ageLabel} · {child.language.toUpperCase()}</p>
    </div>
    {isActive && <span class="badge-active" aria-label="Profil aktif">Aktif</span>}
    {child.archivedAt && <span class="badge-archived" aria-label="Profil diarsipkan">Diarsipkan</span>}
  </div>

  <div class="card-body">
    <p class="goals" aria-label="Tujuan belajar">{goalsPreview}</p>
    <p class="created">Dibuat {new Date(child.createdAt).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })}</p>
  </div>

  <div class="card-actions">
    {isActive && !child.archivedAt && (
      <>
        <a class="btn-secondary" href={onSelect} data-action="select">Pilih</a>
        <a class="btn-link" href={`/parent/anak/${child.childId}`} data-action="summary">Ringkasan</a>
        <a class="btn-tertiary" href={onEdit} data-action="edit">Ubah</a>
        <form action={onArchive} method="post" class="archive-form" data-archive data-child-name={child.nickname}>
          <button class="btn-ghost-danger" type="submit" data-action="archive">Arsipkan</button>
        </form>
        <p class="archive-status" role="status" aria-live="polite" hidden></p>
      </>
    )}
    {child.archivedAt && (
      <span class="archived-note">Profil ini telah diarsipkan. Riwayat belajar tetap tersimpan.</span>
    )}
  </div>
</article>

<script>
  /**
   * Arsipkan profil (VRD 4.10) lewat DELETE `/api/children/:id`.
   *
   * HTML form tidak bisa mengirim DELETE, jadi submit ditangkap di sini:
   * konfirmasi orang tua dulu (gerbang 4.11 sebelum aksi sensitif), lalu
   * fetch DELETE dengan kredensial same-origin. Galat ditampilkan sebagai
   * teks pada live region kartu — status tidak disampaikan lewat warna saja.
   */
  async function archiveSubmit(form: HTMLFormElement) {
    const status = form.parentElement?.querySelector<HTMLElement>(".archive-status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const name = form.dataset.childName ?? "profil ini";
    const endpoint = form.getAttribute("action") ?? "";

    if (!window.confirm(`Arsipkan ${name}? Riwayat belajar tetap tersimpan.`)) return;

    if (status) {
      status.hidden = false;
      status.textContent = "Mengarsipkan…";
      status.dataset.tone = "busy";
    }
    if (button) {
      button.disabled = true;
      button.textContent = "Mengarsipkan…";
    }

    try {
      const res = await fetch(endpoint, {
        method: "DELETE",
        headers: { "content-type": "application/json" },
        credentials: "same-origin",
      });
      if (res.ok) {
        window.location.reload();
        return;
      }
      const body: unknown = await res.json().catch(() => null);
      const message =
        typeof body === "object" && body !== null &&
        typeof (body as { message?: unknown }).message === "string"
          ? (body as { message: string }).message
          : "Coba lagi sebentar lagi.";
      if (status) {
        status.textContent = message;
        status.dataset.tone = "error";
      }
    } catch {
      if (status) {
        status.textContent = "Jaringan bermasalah. Periksa koneksi lalu coba lagi.";
        status.dataset.tone = "error";
      }
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = "Arsipkan";
      }
    }
  }

  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("form[data-archive]")) return;
    event.preventDefault();
    void archiveSubmit(form);
  });
</script>

<style>
  .profile-card {
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card-lg);
    padding: var(--sp-5);
    transition: border-color var(--dur-card) var(--ease-out), box-shadow var(--dur-card) var(--ease-out);
  }
  .profile-card:hover {
    border-color: var(--c-sage);
    box-shadow: var(--shadow-soft);
  }
  .profile-card.active {
    border-color: var(--c-deep-green);
    box-shadow: 0 0 0 2px var(--c-soft-green);
  }
  .profile-card.archived {
    opacity: 0.6;
    background: var(--c-ivory);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .avatar-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--r-card);
    background: var(--c-soft-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .avatar-wrap svg {
    width: 32px;
    height: 32px;
  }

  .info {
    flex: 1;
    min-width: 0;
  }
  .info h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-1);
  }
  .meta {
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
    margin: 0;
  }

  .badge-active {
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    flex-shrink: 0;
  }
  .badge-archived {
    background: var(--c-soft-peach);
    color: var(--c-ink);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    flex-shrink: 0;
  }

  .card-body {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: var(--border-subtle);
  }
  .goals {
    font-size: var(--fs-sm);
    color: var(--c-ink);
    margin: 0 0 var(--sp-2);
  }
  .created {
    font-size: var(--fs-xs);
    color: var(--c-muted-ink);
    margin: 0;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
  .archived-note {
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
    flex: 1;
  }

  /* Button variants following DESIGN.md */
  .btn-secondary,
  .btn-link,
  .btn-tertiary,
  .btn-ghost-danger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-4);
    border-radius: var(--r-control);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--dur-tap) var(--ease-out), background var(--dur-tap) var(--ease-out), box-shadow var(--dur-tap) var(--ease-out);
  }
  .btn-secondary {
    background: var(--c-warm-yellow);
    color: var(--c-ink);
    border: none;
  }
  .btn-secondary:hover {
    /* Cincin inset, bukan latar --c-warning: teks ink di atas warning hanya
       4,43:1 (di bawah WCAG AA 4,5:1). Cincin memakai token --c-ink. */
    box-shadow: inset 0 0 0 2px var(--c-ink);
  }
  .btn-secondary:active {
    transform: scale(0.98);
  }
  .btn-tertiary {
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    border: none;
  }
  .btn-tertiary:hover {
    background: var(--c-sage);
  }
  .btn-tertiary:active {
    transform: scale(0.98);
  }
  /* Tautan teks (ringkasan anak) — sengaja beda dari tombol aksi supaya
     hierarki aksi tetap jelas: Pilih > Ringkasan/Ubah > Arsipkan. */
  .btn-link {
    background: transparent;
    color: var(--c-deep-green);
    border: none;
    text-decoration: underline;
  }
  .btn-link:hover {
    color: var(--c-ink);
  }
  .btn-link:active {
    transform: scale(0.98);
  }
  .btn-ghost-danger {
    background: transparent;
    color: var(--c-error);
    border: var(--border-subtle);
  }
  .btn-ghost-danger:hover {
    background: var(--c-soft-peach);
    border-color: var(--c-error);
  }
  .btn-ghost-danger:active {
    transform: scale(0.98);
  }

  .archive-form {
    margin: 0;
  }

  .archive-status {
    flex: 1 1 100%;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
  }
  .archive-status[data-tone="error"] {
    background: var(--c-soft-peach);
    border-radius: var(--r-control);
    padding: var(--sp-2) var(--sp-3);
  }
  .archive-status[data-tone="busy"] {
    color: var(--c-muted-ink);
  }
  .archive-status[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    .card-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-secondary,
    .btn-link,
    .btn-tertiary,
    .btn-ghost-danger {
      width: 100%;
    }
  }
</style>