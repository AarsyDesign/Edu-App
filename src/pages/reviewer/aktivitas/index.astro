---
/**
 * Daftar aktivitas untuk reviewer (VRD 11.2 — pintu masuk ke editor).
 * Filter area belajar & status lewat query string; sesi reviewer dicek
 * middleware (VRD 11.1).
 *
 * Halaman ini juga menutup tautan mati di dashboard (`/reviewer/aktivitas`
 * dan `/reviewer/aktivitas?area=…`).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getDb } from "../../../lib/db/index.ts";
import { listLearningAreas } from "../../../lib/learning/areas-skills.ts";
import { getActivityTypeLabel, getDifficultyLabel } from "../../../lib/activity/labels.ts";
import {
  REVIEW_STATUSES,
  countReviewerActivities,
  getContentOriginLabel,
  getReviewStatusLabel,
  listReviewerActivities,
} from "../../../lib/activity/reviewer.ts";

const params = Astro.url.searchParams;
const areaCode = params.get("area");
const statusParam = params.get("status")?.toUpperCase() ?? "";
const status = (REVIEW_STATUSES as readonly string[]).includes(statusParam)
  ? statusParam
  : null;

const pageParam = Number.parseInt(params.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const limit = 20;

const db = await getDb();
const areas = await listLearningAreas(db);
const options = { areaCode, status, page, limit };
const total = await countReviewerActivities(db, options);
const activities = await listReviewerActivities(db, options);
const totalPages = Math.max(1, Math.ceil(total / limit));

function pageUrl(nextPage: number): string {
  const query = new URLSearchParams();
  if (areaCode) query.set("area", areaCode);
  if (status) query.set("status", status);
  if (nextPage > 1) query.set("page", String(nextPage));
  const search = query.toString();
  return search ? `/reviewer/aktivitas?${search}` : "/reviewer/aktivitas";
}

const dateFormatter = new Intl.DateTimeFormat("id-ID", {
  dateStyle: "medium",
  timeStyle: "short",
});
---

<BaseLayout title="Daftar Aktivitas" mode="parent">
  <header class="page-header">
    <h1>Daftar Aktivitas</h1>
    <p class="subtitle">Kelola konten belajar. Semua perubahan lewat draf dan review.</p>
  </header>

  <form class="filters" method="get" action="/reviewer/aktivitas" aria-label="Saring daftar aktivitas">
    <div class="filter-field">
      <label for="filter-area">Area belajar</label>
      <select id="filter-area" name="area">
        <option value="">Semua area</option>
        {areas.map((area) => (
          <option value={area.code} selected={areaCode === area.code}>{area.title}</option>
        ))}
      </select>
    </div>

    <div class="filter-field">
      <label for="filter-status">Status</label>
      <select id="filter-status" name="status">
        <option value="">Semua status</option>
        {REVIEW_STATUSES.map((reviewStatus) => (
          <option value={reviewStatus} selected={status === reviewStatus}>
            {getReviewStatusLabel(reviewStatus)}
          </option>
        ))}
      </select>
    </div>

    <button class="btn-secondary" type="submit">Terapkan saringan</button>
  </form>

  <div class="list-actions">
    <a class="btn-primary" href="/reviewer/aktivitas/baru">+ Buat Aktivitas Baru</a>
    <a class="btn-primary" href="/reviewer/aktivitas/impor">Impor Draf AI</a>
    <p class="count" role="status">{total} aktivitas</p>
  </div>

  {activities.length === 0 ? (
    <section class="empty" role="status">
      <h2>Belum ada aktivitas di sini</h2>
      <p>
        {areaCode || status
          ? "Tidak ada yang cocok dengan saringan ini. Ubah saringan atau buat aktivitas baru."
          : "Buat aktivitas pertama — tersimpan sebagai draf sampai di-review."}
      </p>
      <a href="/reviewer/aktivitas/baru">Buat Aktivitas Baru</a>
    </section>
  ) : (
    <ul class="activity-list">
      {activities.map((activity) => (
        <li class="activity-item">
          <div class="item-main">
            <p class="item-prompt">{activity.prompt}</p>
            <p class="item-meta">
              <span>{activity.areaTitle}</span>
              <span aria-hidden="true">·</span>
              <span>{getActivityTypeLabel(activity.interactionType)}</span>
              <span aria-hidden="true">·</span>
              <span>{getDifficultyLabel(activity.difficulty)}</span>
              <span aria-hidden="true">·</span>
              <span>{activity.targetAgeMin}–{activity.targetAgeMax} tahun</span>
            </p>
            <p class="item-tags">
              <span class="tag tag-status">{getReviewStatusLabel(activity.reviewStatus)}</span>
              <span class="tag">{getContentOriginLabel(activity.contentOrigin)}</span>
              <span class="tag">Diubah {dateFormatter.format(activity.updatedAt)}</span>
            </p>
          </div>
          <a class="edit-link" href={`/reviewer/aktivitas/${activity.id}`}>
            Edit
            <span class="sr-only">aktivitas “{activity.prompt}”</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Halaman daftar aktivitas">
      {page > 1 ? (
        <a class="page-link" href={pageUrl(page - 1)}>← Sebelumnya</a>
      ) : (
        <span class="page-link disabled" aria-disabled="true">← Sebelumnya</span>
      )}
      <span class="page-status">Halaman {page} dari {totalPages}</span>
      {page < totalPages ? (
        <a class="page-link" href={pageUrl(page + 1)}>Berikutnya →</a>
      ) : (
        <span class="page-link disabled" aria-disabled="true">Berikutnya →</span>
      )}
    </nav>
  )}

  <p class="back-link">
    <a href="/reviewer">Kembali ke Area Reviewer</a>
  </p>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--sp-5);
    text-align: center;
  }

  .page-header h1 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--sp-2);
    color: var(--c-deep-green);
  }

  .subtitle {
    color: var(--c-muted-ink);
    font-size: var(--fs-base);
    max-width: 52ch;
    margin: 0 auto;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    align-items: end;
    gap: var(--sp-3);
    padding: var(--sp-4);
    margin-bottom: var(--sp-5);
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card);
  }

  .filter-field label {
    display: block;
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-2);
  }

  .filter-field select {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--c-ink);
    background: var(--c-ivory);
    border: var(--border-subtle);
    border-radius: var(--r-control);
  }

  .list-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-5);
    border-radius: var(--r-control);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-tap) var(--ease-out), background var(--dur-tap) var(--ease-out);
  }

  .btn-primary {
    background: var(--c-deep-green);
    color: var(--c-warm-white);
    border: none;
  }

  .btn-primary:hover {
    background: var(--c-ink);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    border: var(--border-subtle);
  }

  .btn-secondary:hover {
    background: var(--c-sage);
  }

  .count {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
  }

  .activity-list {
    list-style: none;
    margin: 0 0 var(--sp-5);
    padding: 0;
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card);
    overflow: hidden;
  }

  .activity-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border-bottom: var(--border-subtle);
  }

  .activity-item:last-child {
    border-bottom: 0;
  }

  .item-main {
    flex: 1 1 240px;
    min-width: 0;
  }

  .item-prompt {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--c-ink);
    overflow-wrap: anywhere;
  }

  .item-meta,
  .item-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
  }

  .item-tags {
    margin-top: var(--sp-2);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--sp-3);
    background: var(--c-ivory);
    border: var(--border-subtle);
    border-radius: var(--r-control);
    color: var(--c-ink);
    font-weight: 600;
  }

  .tag-status {
    background: var(--c-soft-blue);
  }

  .edit-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-4);
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    border: var(--border-subtle);
    border-radius: var(--r-control);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--dur-tap) var(--ease-out);
  }

  .edit-link:hover {
    background: var(--c-sage);
  }

  /* Teks untuk pembaca layar saja (activity.css tidak dimuat halaman ini). */
  .edit-link .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .empty {
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card);
    padding: var(--sp-6);
    text-align: center;
    margin-bottom: var(--sp-5);
  }

  .empty h2 {
    font-size: var(--fs-xl);
    margin: 0 0 var(--sp-2);
  }

  .empty p {
    color: var(--c-muted-ink);
    margin: 0 0 var(--sp-4);
  }

  .empty a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--c-deep-green);
    font-weight: 600;
    text-decoration: none;
  }

  .empty a:hover {
    text-decoration: underline;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-4);
    border: var(--border-subtle);
    border-radius: var(--r-control);
    background: var(--c-warm-white);
    color: var(--c-deep-green);
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .page-link.disabled {
    color: var(--c-muted-ink);
    background: var(--c-ivory);
  }

  .page-status {
    font-size: var(--fs-sm);
    color: var(--c-muted-ink);
  }

  .back-link {
    text-align: center;
    font-size: var(--fs-sm);
  }

  .back-link a {
    color: var(--c-deep-green);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  select:focus-visible,
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--c-deep-green);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .activity-item {
      flex-direction: column;
      align-items: stretch;
    }

    .edit-link {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary,
    .btn-secondary,
    .edit-link {
      transition: none;
    }
  }
</style>
