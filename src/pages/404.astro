---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Halaman tidak ditemukan" mode="parent">
  <section class="err">
    <div class="mark" aria-hidden="true">
      <!-- Ilustrasi geometris: lingkaran + panah kembali (tanpa karakter hidup) -->
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none" style="color: var(--c-deep-green);">
        <circle cx="36" cy="36" r="30" fill="var(--c-soft-blue)" stroke="currentColor" stroke-width="3" />
        <path d="M44 36H28m0 0 8-8m-8 8 8 8" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <h1>Halaman tidak ditemukan</h1>
    <p class="sub">Alamatnya mungkin salah atau sudah dipindah. Ayo kembali ke beranda untuk lanjut belajar.</p>
    <div class="actions">
      <a class="btn-primary" href="/">Kembali ke Beranda</a>
      <a class="btn-ghost" href="/parent">Area Orang Tua</a>
    </div>
  </section>
</BaseLayout>

<style>
  .err {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) 0;
  }
  h1 {
    font-size: var(--fs-xl);
  }
  .sub {
    color: var(--c-muted-ink);
    max-width: 34ch;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    width: min(100%, 320px);
    margin-top: var(--sp-4);
  }
  .btn-primary,
  .btn-ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border-radius: var(--r-card);
    font-family: var(--font-heading);
    font-size: var(--fs-base);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--dur-tap) var(--ease-out);
  }
  .btn-primary {
    background: var(--c-deep-green);
    color: var(--c-warm-white);
  }
  .btn-ghost {
    background: var(--c-warm-white);
    color: var(--c-deep-green);
    border: var(--border-subtle);
  }
  .btn-primary:active,
  .btn-ghost:active {
    transform: scale(0.98);
  }
</style>
