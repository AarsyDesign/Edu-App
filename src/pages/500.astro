---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Ada gangguan" mode="parent">
  <section class="err">
    <div class="mark" aria-hidden="true">
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
        <circle cx="36" cy="36" r="30" fill="#F7DCCB" stroke="#B85A52" stroke-width="3" />
        <path d="M36 22v20M36 48v2" stroke="#B85A52" stroke-width="4" stroke-linecap="round" />
      </svg>
    </div>
    <h1>Ada yang tidak beres</h1>
    <p class="sub">Coba lagi sebentar lagi. Belajar kamu tetap tersimpan.</p>
    <div class="actions">
      <a class="btn-primary" href="/">Kembali ke Beranda</a>
      <button class="btn-ghost" type="button" onclick="location.reload()">Coba Lagi</button>
    </div>
  </section>
</BaseLayout>

<style>
  .err {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) 0;
  }
  h1 {
    font-size: var(--fs-xl);
  }
  .sub {
    color: var(--c-muted-ink);
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    width: min(100%, 320px);
    margin-top: var(--sp-4);
  }
  .btn-primary,
  .btn-ghost {
    min-height: 52px;
    border-radius: var(--r-card);
    font-family: var(--font-heading);
    font-size: var(--fs-base);
    font-weight: 700;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--c-deep-green);
    color: var(--c-warm-white);
    border: none;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-ghost {
    background: var(--c-warm-white);
    color: var(--c-deep-green);
    border: var(--border-subtle);
  }
</style>
