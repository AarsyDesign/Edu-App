---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Belajar" mode="child">
  <section class="hero">
    <div class="mark" aria-hidden="true">
      <!-- Ilustrasi geometris: bintang + buku (DESIGN-SYSTEM §6 — tanpa karakter hidup) -->
      <svg width="96" height="96" viewBox="0 0 96 96" fill="none" style="color: var(--c-deep-green);">
        <rect x="12" y="20" width="72" height="56" rx="10" fill="var(--c-soft-green)" stroke="currentColor" stroke-width="3" />
        <path d="M48 28v44M20 34h20M56 34h20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M70 8l3.5 7.2 8 1.1-5.8 5.6 1.4 7.9L70 26.4l-7.1 3.4 1.4-7.9-5.8-5.6 8-1.1L70 8z" fill="var(--c-warm-yellow)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </div>
    <h1>Mau belajar apa hari ini?</h1>
    <p class="sub">Pilih satu kegiatan, ya.</p>

    <div class="actions">
      <a class="btn-primary" href="/learn">Mulai Belajar</a>
      <a class="btn-ghost" href="/parent">Area Orang Tua</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) 0;
  }
  .mark {
    margin-bottom: var(--sp-6);
  }
  h1 {
    font-size: var(--fs-2xl);
    max-width: 16ch;
  }
  .sub {
    color: var(--c-muted-ink);
    font-size: var(--fs-lg);
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    width: min(100%, 320px);
    margin-top: var(--sp-6);
  }
  .btn-primary,
  .btn-ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    border-radius: var(--r-card);
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--dur-tap) var(--ease-out);
  }
  .btn-primary {
    background: var(--c-deep-green);
    color: var(--c-warm-white);
  }
  .btn-ghost {
    background: var(--c-warm-white);
    color: var(--c-deep-green);
    border: var(--border-subtle);
  }
  .btn-primary:active,
  .btn-ghost:active {
    transform: scale(0.98);
  }
  @media (min-width: 768px) {
    h1 {
      font-size: var(--fs-3xl);
    }
  }
</style>
