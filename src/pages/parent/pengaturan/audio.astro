---
/**
 * Pengaturan Audio (VRD 10.7) — placeholder menunggu keputusan produk (OQ 18).
 * PRD §14: musik OFF default, audio opsional, ada kontrol mute.
 * Keputusan detail (efek suara, instruksi suara, provider TTS) belum ditetapkan.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { parentIdOf } from "../../../lib/children/api.ts";

const parentIdResult = parentIdOf(Astro);
if (parentIdResult instanceof Response) {
  return Astro.redirect("/login");
}
---

<BaseLayout title="Pengaturan Audio" mode="parent">
  <p class="back-link">
    <a href="/parent">← Kembali ke Area Orang Tua</a>
  </p>

  <header class="page-header">
    <h1>Pengaturan Audio</h1>
    <p class="subtitle">Kelola preferensi suara untuk pengalaman belajar.</p>
  </header>

  <section class="section" aria-label="Status pengaturan audio">
    <div class="empty-state">
      <div class="mark" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" style="color: var(--c-deep-green);">
          <path d="M14 32c0-9.9 8.1-18 18-18v4c-7.7 0-14 6.3-14 14s6.3 14 14 14v4c-9.9 0-18-8.1-18-18z" fill="currentColor"/>
          <path d="M44 18v28c11 0 20-9 20-20s-9-20-20-20z" fill="currentColor" opacity="0.6"/>
        </svg>
      </div>
      <h2>Pengaturan audio belum tersedia</h2>
      <p class="empty-desc">
        Fitur ini belum tersedia. Pilihan suaranya sedang disiapkan dan akan
        muncul di halaman ini begitu siap.
      </p>
      <p class="empty-detail">
        Yang sudah pasti: musik <strong>OFF secara bawaan</strong>, setiap fitur audio
        akan memiliki kontrol mute, dan tidak ada suara yang diputar tanpa izin orang tua.
      </p>
      <a class="btn-tertiary" href="/parent">Kembali ke pengaturan</a>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-sm);
  }
  .back-link a {
    color: var(--c-deep-green);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
  .back-link a:hover { text-decoration: underline; }

  .page-header {
    margin-bottom: var(--sp-8);
    text-align: center;
  }
  .page-header h1 { font-size: var(--fs-2xl); margin-bottom: var(--sp-2); }
  @media (min-width: 768px) { .page-header h1 { font-size: var(--fs-3xl); } }
  .subtitle { color: var(--c-muted-ink); font-size: var(--fs-lg); max-width: 50ch; margin-inline: auto; }

  .section { margin-bottom: var(--sp-10); }

  .empty-state {
    text-align: center;
    padding: var(--sp-10) var(--sp-4);
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card-lg);
  }
  .empty-state .mark { margin: 0 auto var(--sp-4); }
  .empty-state h2 { font-size: var(--fs-xl); margin-bottom: var(--sp-3); }
  .empty-desc { color: var(--c-muted-ink); margin-bottom: var(--sp-4); max-width: 50ch; margin-inline: auto; line-height: 1.6; }
  .empty-detail { color: var(--c-ink); font-size: var(--fs-sm); margin-bottom: var(--sp-5); max-width: 50ch; margin-inline: auto; line-height: 1.6; }

  .btn-tertiary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-4);
    border-radius: var(--r-control);
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform var(--dur-tap) var(--ease-out), background var(--dur-tap) var(--ease-out);
  }
  .btn-tertiary:hover { background: var(--c-sage); }
  .btn-tertiary:active { transform: scale(0.98); }
  .reduce-motion .btn-tertiary { transition: none; }
</style>