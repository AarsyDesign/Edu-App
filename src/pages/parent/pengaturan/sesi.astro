---
/**
 * Preferensi Durasi Sesi (VRD 10.8) — placeholder menunggu keputusan produk.
 * PRD §12: preferensi durasi sesi per akun orang tua.
 * Detail kebijakan (batas default, rentang, perilaku saat habis) belum ditetapkan.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { parentIdOf } from "../../../lib/children/api.ts";

const parentIdResult = parentIdOf(Astro);
if (parentIdResult instanceof Response) {
  return Astro.redirect("/login");
}
---

<BaseLayout title="Preferensi Durasi Sesi" mode="parent">
  <p class="back-link">
    <a href="/parent">← Kembali ke Area Orang Tua</a>
  </p>

  <header class="page-header">
    <h1>Preferensi Durasi Sesi</h1>
    <p class="subtitle">Atur batas waktu bermain per sesi belajar.</p>
  </header>

  <section class="section" aria-label="Status pengaturan durasi sesi">
    <div class="empty-state">
      <div class="mark" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" style="color: var(--c-deep-green);">
          <circle cx="32" cy="32" r="24" stroke="currentColor" stroke-width="3" />
          <path d="M32 8v16M32 24a8 8 0 0 1 0 16" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>
      <h2>Pengaturan durasi sesi belum tersedia</h2>
      <p class="empty-desc">
        Fitur ini belum tersedia. Pilihan batas waktunya sedang disiapkan dan
        akan muncul di halaman ini begitu siap.
      </p>
      <p class="empty-detail">
        Yang sudah pasti: batas waktu akan <strong>dapat dikonfigurasi</strong> oleh orang tua,
        default global hidup di kode (bukan database), dan tidak ada pembelian/penagihan
        terkait durasi sesi.
      </p>
      <a class="btn-tertiary" href="/parent">Kembali ke pengaturan</a>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-sm);
  }
  .back-link a {
    color: var(--c-deep-green);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
  .back-link a:hover { text-decoration: underline; }

  .page-header {
    margin-bottom: var(--sp-8);
    text-align: center;
  }
  .page-header h1 { font-size: var(--fs-2xl); margin-bottom: var(--sp-2); }
  @media (min-width: 768px) { .page-header h1 { font-size: var(--fs-3xl); } }
  .subtitle { color: var(--c-muted-ink); font-size: var(--fs-lg); max-width: 50ch; margin-inline: auto; }

  .section { margin-bottom: var(--sp-10); }

  .empty-state {
    text-align: center;
    padding: var(--sp-10) var(--sp-4);
    background: var(--c-warm-white);
    border: var(--border-subtle);
    border-radius: var(--r-card-lg);
  }
  .empty-state .mark { margin: 0 auto var(--sp-4); }
  .empty-state h2 { font-size: var(--fs-xl); margin-bottom: var(--sp-3); }
  .empty-desc { color: var(--c-muted-ink); margin-bottom: var(--sp-4); max-width: 50ch; margin-inline: auto; line-height: 1.6; }
  .empty-detail { color: var(--c-ink); font-size: var(--fs-sm); margin-bottom: var(--sp-5); max-width: 50ch; margin-inline: auto; line-height: 1.6; }

  .btn-tertiary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0 var(--sp-4);
    border-radius: var(--r-control);
    background: var(--c-soft-green);
    color: var(--c-deep-green);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform var(--dur-tap) var(--ease-out), background var(--dur-tap) var(--ease-out);
  }
  .btn-tertiary:hover { background: var(--c-sage); }
  .btn-tertiary:active { transform: scale(0.98); }
  .reduce-motion .btn-tertiary { transition: none; }
</style>